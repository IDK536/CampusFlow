POSTGRES_DB='campusflow'
POSTGRES_USER='campusflow'
POSTGRES_PASSWORD='replace-with-a-random-password'
Jwt__Key='replace-with-a-random-signing-key-of-at-least-32-bytes'
Jwt__Issuer='CampusFlow'
Jwt__Audience='CampusFlowClient'
Jwt__AccessTokenMinutes='60'
Jwt__RefreshTokenDays='7'
Auth__CookieSecure='false'
Auth__AllowedOrigins__0='http://localhost:3000'
Auth__AllowedOrigins__1='http://localhost:5173'
Auth__AllowedOrigins__2='http://localhost:4173'
BACKEND_PORT='8080'
CLIENT_PORT='3000'
CLIENT_BUILD_CONTEXT='./client'
ConnectionStrings__CampusFlow='Host=localhost;Port=5432;Database=campusflow;Username=campusflow;Password=replace-with-a-random-password'
CAMPUSFLOW_TEST_CONNECTION='Host=localhost;Port=5432;Database=campusflow_test;Username=campusflow;Password=replace-with-a-random-password'
