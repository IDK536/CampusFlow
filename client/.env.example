# true (по умолчанию) — backend не нужен: данные и проверки живут в браузере (mock-бэкенд).
# false — запросы идут на реальный API через /api.
VITE_USE_MOCK=true

# Куда dev-сервер Vite проксирует /api, когда VITE_USE_MOCK=false.
VITE_API_TARGET=http://localhost:8080

# Base URL API в браузере. Обычно менять не нужно.
# VITE_API_BASE=/api
